# WatchMate — Production Environment Variables
# Copy this file to .env.production and fill in your actual values.
# Never commit .env.production to version control.

# ─────────────────────────────────────────────
# Domain
# ─────────────────────────────────────────────

# Your fully qualified production domain name
DOMAIN=your-domain.com

# ─────────────────────────────────────────────
# URLs
# ─────────────────────────────────────────────

# The public HTTPS URL of your backend (used by backend CORS)
CLIENT_URL=https://your-domain.com

# URLs injected into Vite client build
VITE_API_URL=https://your-domain.com
VITE_SOCKET_URL=https://your-domain.com

# ─────────────────────────────────────────────
# TURN Server Credentials
# Used by the frontend WebRTC RTCConfig
# ─────────────────────────────────────────────

VITE_TURN_URL=turns:your-domain.com:5349
VITE_TURN_USERNAME=watchmate
VITE_TURN_PASSWORD=REPLACE_WITH_STRONG_TURN_PASSWORD

# ─────────────────────────────────────────────
# Backend Server
# ─────────────────────────────────────────────

NODE_ENV=production
PORT=3001
REDIS_URL=redis://redis:6379

# ─────────────────────────────────────────────
# TURN Shared Secret (for HMAC dynamic auth, optional)
# ─────────────────────────────────────────────

TURN_SECRET=REPLACE_WITH_RANDOM_SECRET_64CHARS
