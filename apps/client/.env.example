# WatchMate Frontend Environment Variables
# Copy to .env for local development overrides

# Backend REST API Base URL
VITE_API_URL=http://localhost:3001

# Backend Socket.IO Server Base URL
VITE_SOCKET_URL=http://localhost:3001

# ─── Production TURN Server (leave blank for local dev) ───
# VITE_TURN_URL=turns:your-domain.com:5349
# VITE_TURN_USERNAME=watchmate
# VITE_TURN_PASSWORD=your-turn-password
