# =============================================================================
# WatchMate — Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running the server.
#   cp .env.example .env
#
# NEVER commit .env to Git. It is listed in /.gitignore.
# This file (.env.example) IS committed — it documents every required variable.
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3001

# Runtime environment. Use "development" locally, "production" in deployment.
# Controls log verbosity, error detail in responses, etc.
NODE_ENV=development


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# The exact origin of the frontend. No trailing slash.
# In development this is the Vite dev server.
# In production this is your deployed frontend URL.
# The server rejects all cross-origin requests from any other origin.
CORS_ORIGIN=http://localhost:5173


# -----------------------------------------------------------------------------
# REDIS
# (Phase 4 — Room Service)
# -----------------------------------------------------------------------------

# Full Redis connection URL.
# Local dev: redis://localhost:6379
# Redis Cloud / Upstash: rediss://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# Time-to-live for room keys in Redis, in seconds.
# Default: 7200 (2 hours). Room keys are refreshed on every room event.
# This is the safety net TTL — primary deletion is via application logic
# when the last participant leaves.
ROOM_TTL_SECONDS=7200

# Maximum number of concurrently active rooms.
# This is a cap on live rooms, not a daily limit.
# Increase for production. Keep low for local testing of the limit logic.
MAX_ACTIVE_ROOMS=5


# -----------------------------------------------------------------------------
# RECONNECT
# (Phase 5 — Reconnect Service)
# -----------------------------------------------------------------------------

# Grace period (in milliseconds) during which a disconnected user can reconnect
# and have their role, identity, and room membership fully restored.
# Default: 20000 (20 seconds).
RECONNECT_GRACE_PERIOD_MS=20000


# -----------------------------------------------------------------------------
# RATE LIMITING
# (Phase 6 — Chat + Validation)
# -----------------------------------------------------------------------------

# Maximum number of chat messages a single userToken can send within the window.
RATE_LIMIT_CHAT_MAX_MESSAGES=20

# Rolling window size for chat rate limiting, in milliseconds.
# Default: 10000 (10 seconds) — so 20 messages per 10 seconds per token.
RATE_LIMIT_CHAT_WINDOW_MS=10000

# Maximum number of general API requests per IP per minute (health, telemetry).
# Applies to REST endpoints, not WebSocket events.
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000


# -----------------------------------------------------------------------------
# LOGGING
# (Phase 3 — Structured Logging)
# -----------------------------------------------------------------------------

# Pino log level. One of: trace | debug | info | warn | error | fatal
# Use "debug" in development, "info" in production.
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# TURN / ICE
# (Phase 8 — WebRTC)
# -----------------------------------------------------------------------------

# Comma-separated list of TURN/STUN server URLs.
# Self-hosted coturn example:  turn:your-server.com:3478
# Metered.ca example:          turn:relay.metered.ca:80
# Multiple values example:     stun:stun.l.google.com:19302,turn:your-server.com:3478
TURN_URLS=turn:your-turn-server.com:3478

# TURN server credentials (long-term credential mechanism).
# These are sent to the client at room join time — never hardcoded in frontend.
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential
